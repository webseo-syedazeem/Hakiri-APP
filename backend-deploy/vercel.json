{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/ping", "destination": "/api/ping" },
    { "source": "/(.*)", "destination": "/api" }
  ],
  "crons": [
    {
      "path": "/api/cron/daily-reminders",
      "schedule": "0 14 * * *"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 90,
      "includeFiles": "{server.js,controllers/**,models/**,routes/**,middleware/**,config/**,helpers/**,data/**,services/**}"
    }
  }
}
