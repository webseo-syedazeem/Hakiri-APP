PORT=5055
NODE_ENV=development
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/hakkiri?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-string
GEMINI_API_KEY=replace-with-ai-studio-key
# Live coach (server falls back if unavailable on the key).
GEMINI_LIVE_MODEL=gemini-3.8-live
# New Gemini accounts: use 3.8 Flash (2.5 is blocked for new users).
GEMINI_FLASH_MODEL=gemini-3.8-flash
# Optional only — Gemini TTS already uses warm human-style voices by default.
# ELEVENLABS_API_KEY=
# Optional Apple Services IDs (comma-separated) for Android/web Apple Sign-In.
# Native iOS already accepts com.hakkiri.app.
# APPLE_CLIENT_IDS=com.hakkiri.app.service
# Firebase Admin (FCM). Prefer JSON string on Vercel; local file under secrets/ is fine.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-adminsdk.json
# Protects GET/POST /api/cron/daily-reminders (set same value in Vercel Cron header if needed)
CRON_SECRET=replace-with-long-random-string
# Gmail SMTP for forgot-password OTP (use a Google App Password, not your normal password).
# https://myaccount.google.com/apppasswords
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Optional display-from override (defaults to GMAIL_USER)
# GMAIL_FROM=your-gmail@gmail.com
# Admin secret for complimentary Pro grant/revoke (header x-admin-secret).
# REVERT: remove if you drop complimentary access.
ADMIN_SECRET=replace-with-long-random-admin-secret
